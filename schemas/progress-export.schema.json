        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "outcome"
            ],
            "properties": {
              "item": {
                "type": "string",
