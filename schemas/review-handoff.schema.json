{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jpmmatias/skills/main/schemas/review-handoff.schema.json",
  "title": "Learncraft lesson-panel handoff files",
  "description": "Frontmatter of the files under .review/<slug>/ (raw/02-ai-architecture.md Proposal 3): state.md ($defs.state, orchestrator-owned), r<N>-author.md ($defs.author) and r<N>-<role>.md ($defs.review). Validate one file with validate(schema, data, {ref: \"#/$defs/state\"}). Cross-file rules (reviewed_sha256 equals the author's content_sha256) and \"REVISE needs a blocker or major item\" (handoffLint) are checked outside the schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/author"
    },
    {
      "$ref": "#/$defs/review"
    }
  ],
  "$defs": {
    "state": {
      "title": "state.md",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson",
        "file",
        "profile",
        "round",
        "round_cap",
        "status"
      ],
      "properties": {
        "lesson": {
          "type": "string",
          "pattern": "^l\\d+$"
        },
        "file": {
          "type": "string",
          "pattern": "^lessons/[A-Za-z0-9._-]+\\.html$"
        },
        "profile": {
          "enum": [
            "fast",
            "balanced",
            "deep"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "round_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "status": {
          "enum": [
            "drafting",
            "in_review",
            "approved",
            "escalated",
            "paused"
          ]
        },
        "sources": {
          "enum": [
            "pending",
            "done"
          ],
          "description": "pending after an offline session: the next online session researches first."
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fetches_used": {
              "type": "integer",
              "minimum": 0
            },
            "fetches_max": {
              "type": "integer",
              "minimum": 0
            },
            "agent_calls_used": {
              "type": "integer",
              "minimum": 0
            },
            "agent_calls_max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "verdicts"
            ],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "verdicts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "expert": {
                    "enum": [
                      "APPROVE",
                      "REVISE",
                      "BLOCKED"
                    ]
                  },
                  "novice": {
                    "enum": [
                      "APPROVE",
                      "REVISE",
                      "BLOCKED"
                    ]
                  },
                  "flow": {
                    "enum": [
                      "APPROVE",
                      "REVISE",
                      "BLOCKED"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "author": {
      "title": "r<N>-author.md",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson",
        "round",
        "content_sha256",
        "check"
      ],
      "properties": {
        "lesson": {
          "type": "string",
          "pattern": "^l\\d+$"
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "check": {
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "check_reason": {
          "type": "string",
          "maxLength": 200
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "motion": {
          "type": "string",
          "maxLength": 40,
          "description": "Must equal the NOTES.md per-lesson decision."
        },
        "sources_cited": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[RS]\\d{1,4}$"
          }
        },
        "sources_request": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "addressed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/addressed"
          }
        }
      }
    },
    "addressed": {
      "title": "addressed item",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[ENF]-\\d{1,3}$"
        },
        "action": {
          "enum": [
            "fixed",
            "declined"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "anyOf": [
        {
          "title": "fixed",
          "properties": {
            "action": {
              "const": "fixed"
            }
          }
        },
        {
          "title": "declined with reason",
          "required": [
            "reason"
          ],
          "properties": {
            "action": {
              "const": "declined"
            }
          }
        }
      ]
    },
    "review": {
      "title": "r<N>-<role>.md",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson",
        "role",
        "round",
        "reviewed_sha256",
        "independence",
        "verdict",
        "items"
      ],
      "properties": {
        "lesson": {
          "type": "string",
          "pattern": "^l\\d+$"
        },
        "role": {
          "enum": [
            "expert",
            "novice",
            "flow"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "reviewed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "independence": {
          "enum": [
            "subagent",
            "self"
          ]
        },
        "verdict": {
          "enum": [
            "APPROVE",
            "REVISE",
            "BLOCKED"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "problem"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[ENF]-\\d{1,3}$"
              },
              "severity": {
                "enum": [
                  "blocker",
                  "major",
                  "minor"
                ]
              },
              "location": {
                "type": "string",
                "maxLength": 200
              },
              "quote": {
                "type": "string",
                "maxLength": 1000
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "fix": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "lesson": "l3",
      "file": "lessons/0003-batching.html",
      "profile": "balanced",
      "round": 2,
      "round_cap": 2,
      "status": "in_review",
      "budget": {
        "fetches_used": 5,
        "fetches_max": 8,
        "agent_calls_used": 4
      },
      "history": [
        {
          "round": 1,
          "verdicts": {
            "expert": "REVISE",
            "novice": "APPROVE"
          }
        }
      ]
    },
    {
      "lesson": "l3",
      "round": 2,
      "content_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "check": "skipped",
      "check_reason": "no-playwright",
      "motion": "scene",
      "sources_cited": [
        "S3",
        "S4"
      ],
      "sources_request": [],
      "addressed": [
        {
          "id": "E-2",
          "action": "fixed",
          "note": "recomputed 0.83 → 0.81"
        },
        {
          "id": "N-1",
          "action": "declined",
          "reason": "conflicts with E-1 (scope); precedence: expert"
        }
      ]
    },
    {
      "lesson": "l3",
      "role": "expert",
      "round": 2,
      "reviewed_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "independence": "subagent",
      "verdict": "REVISE",
      "items": [
        {
          "id": "E-1",
          "severity": "major",
          "location": "#worked-example",
          "quote": "0.83",
          "problem": "Arithmetic error in the softmax.",
          "fix": "Recompute: 0.81."
        }
      ]
    }
  ]
}
