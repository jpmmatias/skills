{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jpmmatias/skills/main/schemas/learning-record-frontmatter.schema.json",
  "title": "Learncraft learning-record frontmatter",
  "description": "Optional YAML frontmatter of learning-records/NNNN-*.md. Records without frontmatter stay valid. A course.js milestone with status mastered and evidence LR-NNNN should point at a record with kind demonstrated and result pass.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LR-\\d{4}$"
    },
    "kind": {
      "enum": [
        "demonstrated",
        "claimed",
        "misconception",
        "mission-change",
        "prior"
      ],
      "description": "demonstrated = graded evidence; claimed/prior = what the learner said (placement only, never mastery)."
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9.-]{0,39}$"
    },
    "result": {
      "enum": [
        "pass",
        "miss"
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "status"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "enum": [
              "met",
              "not_met",
              "unverifiable"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000,
            "description": "Quote or pointer into the learner's work."
          }
        }
      }
    },
    "transfer": {
      "type": "boolean",
      "description": "The challenge context differed from every practice item and earlier challenge (L6)."
    },
    "transfer_reason": {
      "type": "string",
      "maxLength": 300,
      "description": "One line naming the new context (different data, domain or tool)."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "examples": [
    {
      "id": "LR-0004",
      "kind": "demonstrated",
      "milestone": "m2",
      "result": "pass",
      "criteria": [
        {
          "text": "Computes the attention weights for a 3-token input",
          "status": "met",
          "evidence": "weights.py lines 4–12"
        }
      ],
      "transfer": false,
      "date": "2026-11-24"
    },
    {
      "id": "LR-0001",
      "kind": "prior",
      "date": "2026-11-20"
    }
  ]
}
